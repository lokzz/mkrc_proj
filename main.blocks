<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="K%(;9MgkRNODjsEbO}7V" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="_-:4M9SesysoI{O#HMZ^"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="let current_screen = 0" numlines="1" declaredvars="current_screen"></mutation><next><block type="device_while" id="s9!MF/e1}I7imJFk|d1k"><comment pinned="false" h="80" w="160">0 = menu, 1 = upgrades screen, 2-6 = levels 1-5</comment><data>{"commentRefs":[],"fieldData":{"~commentOffsetX":"16","~commentOffsetY":"16"}}</data><value name="COND"><shadow type="logic_boolean" id="kK0(j,Pjmhb^DEKG@bPI"><field name="BOOL">TRUE</field></shadow></value><statement name="DO"><block type="typescript_statement" id="G]~956NnL:S:]6Ba=%=S"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="switch (current_screen) {" line1="        case 0:" line2="            cleanup()" line3="            // let int_menu = sprites.create(assets.image`nil`, SpriteKind.Player)" line4="            // int_menu.y = 120" line5="            // int_menu.sayText(&quot;Menu: (use A to switch, B to select.)\nLevel 1\nLevel 2&quot;, 50000000)" line6="            // screen.print(&quot;Menu: (use A to switch, B to select.)\nLevel 1\nLevel 2&quot;, 0,0)" line7="            let selection = 0 // bump this up by 2 when using this var to modify current_screen" line8="            let difficulty = 1 // 0 = ez 1 = normal, 2 = hard (optional code, ez = 0.5x spawn/hp?, normal = 1x, hard = 1.5x)" line9="            let dbg_isPressedA = false" line10="            let dbg_pressedData = [0, 0]" line11="            const lvlList = [&quot;Level 1&quot;, &quot;Level 2&quot;, &quot;Level 3&quot;, &quot;Level 4&quot;, &quot;Level 5&quot;]" line12="            const diff_lv = [&quot;Easy&quot;, &quot;Normal&quot;, &quot;Hard&quot;]" line13="            game.onPaint(function () {" line14="                screen.print(`Main Menu:\n(Dpad: move, A: select)\n\n\n\n\n\n\n\n\npress_data=[${dbg_pressedData[0]}, ${dbg_pressedData[1]}]\n@proj v0.1`, 0, 0)" line15="                // build the menu string &amp; display here" line16="                screen.print(&quot;\n\n\n&quot;+selection + &quot; - &quot; + difficulty, 0, 0)" line17="                let builtstr = &quot;&quot;" line18="                lvlList.forEach(function(name, idx) {builtstr += selection === idx ? &quot;&gt;&quot; : &quot;&quot;; builtstr += name; builtstr += selection === idx ? (&quot; - &quot; + diff_lv[difficulty]) : &quot;&quot;; builtstr += &quot;\n&quot;})" line19="                screen.print(&quot;\n\n\n\n&quot; + builtstr, 0, 0)" line20="            })" line21="            controller.up.onEvent(ControllerButtonEvent.Pressed, function () { selection -= 1; selection &lt; 0 ? selection = 4 : false})" line22="            controller.down.onEvent(ControllerButtonEvent.Pressed, function () { selection += 1; selection &gt; 4 ? selection = 0 : false})" line23="            controller.left.onEvent(ControllerButtonEvent.Pressed, function () { difficulty -= 1; difficulty &lt; 0 ? difficulty = 2 : false})" line24="            controller.right.onEvent(ControllerButtonEvent.Pressed, function () { difficulty += 1; difficulty &gt; 2 ? difficulty = 0 : false})" line25="            controller.A.onEvent(ControllerButtonEvent.Pressed, function () { dbg_isPressedA = true; dbg_pressedData = [selection, difficulty]})" line26="            pauseUntil(() =&gt; selection === -1)" line27="    }" numlines="28"></mutation></block></statement></block></next></block></statement></block><block type="function_definition" id="6LOH8,Xg$nuBmEHFc~v*" x="1518" y="0"><mutation name="cleanup" functionid="-?gTWYsFH;ameFHxnz{:"></mutation><field name="function_name">cleanup</field><statement name="STACK"><block type="typescript_statement" id="W`XF2x.]O*W5d~k8_){y"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="game.onPaint(function() {})" numlines="1"></mutation><next><block type="typescript_statement" id="yJ8elfWha$]q7X-v5_Q."><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.A.onEvent(ControllerButtonEvent.Pressed, function() {})" numlines="1"></mutation><next><block type="typescript_statement" id=";/#,O#1=uhMWa+rcn^WA"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.B.onEvent(ControllerButtonEvent.Pressed, function() {})" numlines="1"></mutation><next><block type="typescript_statement" id="1-/!gIU^;t`ra)OKZL?@"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.up.onEvent(ControllerButtonEvent.Pressed, function() {})" numlines="1"></mutation><next><block type="typescript_statement" id="%+Q:R$hv9ER%e+,TKGS_"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.down.onEvent(ControllerButtonEvent.Pressed, function() {})" numlines="1"></mutation><next><block type="typescript_statement" id="$+B?!(tFjjwS`Y=Gy$o^"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.left.onEvent(ControllerButtonEvent.Pressed, function() {})" numlines="1"></mutation><next><block type="typescript_statement" id="#${k0dw7%UPCYC2_v=Ds"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.right.onEvent(ControllerButtonEvent.Pressed, function() {})" numlines="1"></mutation></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>