<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="[R009O[7ZI0J|yvo-Nbd">current_screen</variable><variable id="1[f_cTNf+Q^y0{Bp(lnE">current_diff</variable></variables><block type="function_definition" id="Sl8%L%o~~|iU;tB0(fNY" x="446" y="-72"><mutation name="cleanup" functionid="9*jIRGgU-jiPYZe1FklS"></mutation><field name="function_name">cleanup</field><statement name="STACK"><block type="typescript_statement" id=":.uE}ke_1xu,c:-z1-My"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.A.onEvent(pressDown, function () {})" numlines="1"></mutation><next><block type="typescript_statement" id="!yc1pQ2x;`7r=z9}{?)*"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.B.onEvent(pressDown, function () {})" numlines="1"></mutation><next><block type="typescript_statement" id="*GeyG6a45s^~8!xFM=Ah"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.up.onEvent(pressDown, function () {})" numlines="1"></mutation><next><block type="typescript_statement" id="9c0*j3]Uu,,rFqO~!Gpa"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.down.onEvent(pressDown, function () {})" numlines="1"></mutation><next><block type="typescript_statement" id="Amg|+hg5.kIN11Rh.~Vu"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.left.onEvent(pressDown, function () {})" numlines="1"></mutation><next><block type="typescript_statement" id="O6@|W#:nLMr9+/pnSJBs"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.right.onEvent(pressDown, function () {})" numlines="1"></mutation></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="pxt-on-start" id="~-g{P2+^(ty#u2MuW_Qx" x="0" y="0"><statement name="HANDLER"><block type="variables_set" id=";$!5G_5$$qWHv1R#@yk="><field name="VAR" id="[R009O[7ZI0J|yvo-Nbd">current_screen</field><value name="VALUE"><shadow type="math_number" id="s[,~WZdl^Z[`7)cLpyu#"><field name="NUM">1</field></shadow></value><next><block type="variables_set" id="d.Qx~TT(_/}X8,Xv@S}0"><field name="VAR" id="1[f_cTNf+Q^y0{Bp(lnE">current_diff</field><comment pinned="false" h="80" w="160">keep as-is for now, this should be from 0.5-1.5 (or 0.5-2.0) at max.</comment><value name="VALUE"><shadow type="math_number" id="gh~eese*cXJ#~-.;{rRz"><field name="NUM">1</field></shadow></value><next><block type="typescript_statement" id="HPZi;-*]=17HuRgtF3_="><mutation xmlns="http://www.w3.org/1999/xhtml" line0="game.debug = true" numlines="1"></mutation><next><block type="typescript_statement" id=",D_VBLZEID3`bmqIqmdH"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="game.stats = true" numlines="1"></mutation><next><block type="typescript_statement" id="a|J!=,XNMHQ0LzJXY1B9"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="const pressDown = ControllerButtonEvent.Pressed" numlines="1" declaredvars="pressDown"></mutation><next><block type="device_while" id="2|O(|%Ei;*R/9}3?aY{="><comment pinned="false" h="80" w="160">0 = menu, 1 = upgrades screen, 2-6 = levels 1-5</comment><value name="COND"><shadow type="logic_boolean" id="+Bwh^1h]Fk.!AtpoHvz0"><field name="BOOL">TRUE</field></shadow></value><statement name="DO"><block type="typescript_statement" id="WJEwQ92$MsbZlp+zNI(2"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="switch (current_screen) {" line1="        case 0:" line2="            cleanup()" line3="            let selection = 0 // bump this up by 2 when using this var to modify current_screen" line4="            let difficulty = 1 // 0 = ez 1 = normal, 2 = hard (optional code, ez = 0.5x spawn/hp?, normal = 1x, hard = 1.5x)" line5="            let dbg_isPressedA = false" line6="            let dbg_pressedData = [0, 0]" line7="            const lvlList = [&quot;Level 1&quot;, &quot;Level 2&quot;, &quot;Level 3&quot;, &quot;Level 4&quot;, &quot;Level 5&quot;]" line8="            const diff_lv = [&quot;Easy&quot;, &quot;Normal&quot;, &quot;Hard&quot;]" line9="            game.onPaint(function () {" line10="                if (!(current_screen === 0)) {" line11="                    return" line12="                }" line13="                screen.print(`Main Menu:\n(Dpad: move, A: select)\n\n\n\n\n\n\n\n\npress_data=[${dbg_pressedData[0]}, ${dbg_pressedData[1]}]\n@proj v0.1`, 0, 0)" line14="                // build the menu string &amp; display here" line15="                screen.print(&quot;\n\n\n\n\n\n\n\n\n&quot; + selection + &quot; - &quot; + difficulty, 0, 0) // debug" line16="                let builtstr = &quot;&quot;" line17="                lvlList.forEach(function (name, idx) { builtstr += `${selection === idx ? &quot;&gt;&quot; : &quot;&quot;} ${name} ${selection === idx ? (&quot; - &quot; + diff_lv[difficulty]) : &quot;&quot;}\n`})" line18="                screen.print(&quot;\n\n\n&quot; + builtstr, 0, 0)" line19="            })" line20="            controller.up.onEvent(pressDown, function () { selection -= 1; selection &lt; 0 ? selection = 4 : false })" line21="            controller.down.onEvent(pressDown, function () { selection += 1; selection &gt; 4 ? selection = 0 : false })" line22="            controller.left.onEvent(pressDown, function () { difficulty -= 1; difficulty &lt; 0 ? difficulty = 2 : false })" line23="            controller.right.onEvent(pressDown, function () { difficulty += 1; difficulty &gt; 2 ? difficulty = 0 : false })" line24="            controller.A.onEvent(pressDown, function () { dbg_isPressedA = true; dbg_pressedData = [selection, difficulty] })" line25="            pauseUntil(() =&gt; dbg_isPressedA)" line26="            current_screen = selection + 2" line27="" line28="        case 1:" line29="            cleanup()" line30="            let sel: any = null // literally a 0 and a 1, true = sld, false = atk, null = unselected" line31="            let upg_sld = sprites.create(assets.image`upg_sld`, SpriteKind.Player)" line32="            let upg_atk = sprites.create(assets.image`upg_atk`, SpriteKind.Player)" line33="            // scaling.scaleToPercent(upg_sld, 125, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line34="            // scaling.scaleToPercent(upg_atk, 125, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line35="            game.onUpdateInterval(50, function() {" line36="                if (sel === null) { return }" line37="                else if (sel === true) { " line38="                    scaling.scaleToPercent(upg_sld, 150, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line39="                    scaling.scaleToPercent(upg_atk, 100, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line40="                }" line41="                else {" line42="                    scaling.scaleToPercent(upg_sld, 100, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line43="                    scaling.scaleToPercent(upg_atk, 150, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line44="                }" line45="            })" line46="            controller.left.onEvent(pressDown, function () {sel = !sel})" line47="            controller.right.onEvent(pressDown, function () {sel = !sel})" line48="            upg_sld.x -= 35" line49="            upg_atk.x += 35" line50="" line51="            pauseUntil(() =&gt; current_screen === -516)" line52="" line53="" line54="" line55="        default:" line56="            cleanup()" line57="            game.onPaint(function() {" line58="                screen.print(&quot;\n\n\n\n   CRASH:\n   UNKNOWN SCREENID &quot; + current_screen + difficulty, 0, 0)" line59="            })" line60="            pauseUntil(() =&gt; current_screen === -517)" line61="    }" numlines="62"></mutation></block></statement></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>