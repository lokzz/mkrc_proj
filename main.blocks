tion><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="gameD_scores = savedData.scr" numlines="1"></mutation><next><block type="device_while"><comment pinned="false" h="80" w="160">0 = menu, 1 = upgrades screen, 2-6 = levels 1-5</comment><value name="COND"><shadow type="logic_boolean"><field name="BOOL">TRUE</field></shadow></value><statement name="DO"><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="switch (current_screen) {" line1="        case 0:" line2="            cleanup()" line3="            let selection = 0 // bump this up by 2 when using this var to modify current_screen" line4="            let difficulty = 1 // 0 = ez 1 = normal, 2 = hard (optional code, ez = 0.5x spawn/hp?, normal = 1x, hard = 1.5x)" line5="            let dbg_isPressedA = false" line6="            let dbg_pressedData = [0, 0]" line7="            const lvlList = [&quot;Level 1&quot;, &quot;Level 2&quot;, &quot;Level 3&quot;, &quot;Level 4&quot;, &quot;Level 5&quot;]" line8="            const diff_lv = [&quot;Easy&quot;, &quot;Normal&quot;, &quot;Hard&quot;]" line9="            prt_id = &quot;0-1&quot;" line10="            if (prt_summoned.find(function (v, i) { return v === &quot;0-1&quot; }) === undefined) {" line11="                game.onPaint(function () {" line12="                    if (!(prt_id === &quot;0-1&quot;)) { return }" line13="" line14="                    screen.print(`Main Menu:\n(Dpad: move, A: select)\n\n\n\n\n\n\n\n\npress_data=[${dbg_pressedData[0]}, ${dbg_pressedData[1]}]\n@proj v0.1`, 0, 0)" line15="                    // build the menu string &amp; display here" line16="                    screen.print(&quot;\n\n\n\n\n\n\n\n\n&quot; + selection + &quot; - &quot; + difficulty, 0, 0) // debug" line17="                    let builtstr = &quot;&quot;" line18="                    lvlList.forEach(function (name, idx) { builtstr += `${selection === idx ? &quot;&gt;&quot; : &quot;&quot;} ${name} ${selection === idx ? (&quot; - &quot; + diff_lv[difficulty]) : &quot;&quot;}${(selection === idx &amp;&amp; gameD_scores[selection][difficulty] != -1) ? &quot; &gt; &quot; + gameD_scores[selection][difficulty] : &quot;&quot;}\n` })" line19="                    screen.print(&quot;\n\n\n&quot; + builtstr, 0, 0)" line20="                })" line21="                prt_summoned.push(&quot;0-1&quot;)" line22="            }" line23="            controller.up.onEvent(pressDown, function () { selection -= 1; selection &lt; 0 ? selection = 4 : false })" line24="            controller.down.onEvent(pressDown, function () { selection += 1; selection &gt; 4 ? selection = 0 : false })" line25="            controller.left.onEvent(pressDown, function () { difficulty -= 1; difficulty &lt; 0 ? difficulty = 2 : false })" line26="            controller.right.onEvent(pressDown, function () { difficulty += 1; difficulty &gt; 2 ? difficulty = 0 : false })" line27="            controller.A.onEvent(pressDown, function () { dbg_isPressedA = true; dbg_pressedData = [selection, difficulty] })" line28="            pauseUntil(() =&gt; dbg_isPressedA)" line29="            current_screen = selection + 2" line30="            " line31="            doExitScene()" line32="            break" line33="" line34="        case 1:" line35="            cleanup()" line36="            sel = null // literally a 0 and a 1, true = sld, false = atk, null = unselected" line37="            let upg_sld = sprites.create(assets.image`upg_sld`, SpriteKind.Player)" line38="            let upg_atk = sprites.create(assets.image`upg_atk`, SpriteKind.Player)" line39="            // if (gameD_Upgrades[0] &gt; 2) {" line40="            //     var nimg = assets.image`upg_sld`" line41="" line42="            //     upg_sld.setImage()" line43="            // }" line44="            // scaling.scaleToPercent(upg_sld, 125, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line45="            // scaling.scaleToPercent(upg_atk, 125, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line46="            game.onUpdateInterval(50, function () {" line47="                if (sel === null) { return }" line48="                else if (sel === true) { // again: true = sld, false = atk, null = unselected" line49="                    scaling.scaleToPercent(upg_sld, 150, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line50="                    scaling.scaleToPercent(upg_atk, 100, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line51="                }" line52="                else {" line53="                    scaling.scaleToPercent(upg_sld, 100, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line54="                    scaling.scaleToPercent(upg_atk, 150, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line55="                }" line56="            })" line57="            prt_id = &quot;1-1&quot;" line58="            if (prt_summoned.find(function (v, i) { return v === &quot;1-1&quot; }) === undefined) {" line59="                game.onPaint(function () {" line60="                    if (!(prt_id === &quot;1-1&quot;)) { return }" line61="" line62="                    screen.print(&quot;\n    Choose an upgrade:\n     +DEF   or   +ATK&quot;, 2, 0)" line63="                    console.log(sel)" line64="                    if (sel === null) { return }" line65="                    else if (sel === true) { // again: true = sld, false = atk, null = unselected" line66="                        let upgrade_str: string" line67="                        if (gameD_Upgrades[0] &gt;= 3) {" line68="                            upgrade_str = &quot;Max&quot;" line69="                        } else {" line70="                            upgrade_str = &quot;&quot; + gameD_Upgrades[0] + &quot;-&gt;&quot; + (gameD_Upgrades[0] + 1)" line71="                        }" line72="                        screen.print(&quot;\n\n\n\n+Defense &quot; + upgrade_str, 0, 12, 0, image.scaledFont(image.font8, 2))" line73="                        screen.print(&quot;\n\n\n\n\n\n\n\n\n\n   Increases your tank's\n   health&quot;, 0, 0)" line74="                    }" line75="                    else {" line76="                        let upgrade_str2: string" line77="                        if (gameD_Upgrades[1] &gt;= 3) {" line78="                            upgrade_str2 = &quot;Max&quot;" line79="                        } else {" line80="                            upgrade_str2 = &quot;&quot; + gameD_Upgrades[1] + &quot;-&gt;&quot; + (gameD_Upgrades[1] + 1)" line81="                        }" line82="                        screen.print(&quot;\n\n\n\n+Attack  &quot; + upgrade_str2, 0, 12, 0, image.scaledFont(image.font8, 2))" line83="                        screen.print(&quot;\n\n\n\n\n\n\n\n\n\n   Upgrades  your tank's\n   bullets&quot;, 0, 0)" line84="                    }" line85="                })" line86="                prt_summoned.push(&quot;1-1&quot;)" line87="            }" line88="            // function updateText()" line89="            controller.left.onEvent(pressDown, function () { sel = !sel; console.log(&quot;Left&quot;) })" line90="            controller.right.onEvent(pressDown, function () { sel = !sel; console.log(&quot;right&quot;) })" line91="            upg_sld.x -= 35" line92="            upg_atk.x += 35" line93="" line94="            let selected = -1" line95="            controller.A.onEvent(pressDown, function () {" line96="                if (sel === true &amp;&amp; gameD_Upgrades[0] &lt; 3) { // again: true = sld, false = atk, null = unselected" line97="                    selected = 0" line98="                    //gameD_Upgrades[0] += 1" line99="                }" line100="                else if (sel === false &amp;&amp; gameD_Upgrades[1] &lt; 3) {" line101="                    selected = 1" line102="                    //gameD_Upgrades[1] += 1" line103="                } // wtf?" line104="                return" line105="            })" line106="            pauseUntil(() 