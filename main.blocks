<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="Rd-z1b9SW:B$fVVNAe0V">current_screen</variable><variable id="xM}r[WgAyW(qyYG=ERW/">prt_id</variable><variable id="4wutayjN*%nCO9$DY9@@">current_diff</variable><variable id="+ns=oPAU|a;M/Pv|78a]">gameD_Upgrades</variable></variables><block type="pxt-on-start" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="let prt_summoned: Array&lt;string&gt; = []" numlines="1" declaredvars="prt_summoned"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="const pressDown = ControllerButtonEvent.Pressed" numlines="1" declaredvars="pressDown"></mutation><next><block type="variables_set"><field name="VAR" id="Rd-z1b9SW:B$fVVNAe0V">current_screen</field><value name="VALUE"><shadow type="math_number"><field name="NUM">113</field></shadow></value><next><block type="variables_set"><field name="VAR" id="xM}r[WgAyW(qyYG=ERW/">prt_id</field><value name="VALUE"><shadow type="math_number"><field name="NUM">0</field></shadow><block type="text"><field name="TEXT">-1</field></block></value><next><block type="variables_set"><field name="VAR" id="4wutayjN*%nCO9$DY9@@">current_diff</field><comment pinned="false" h="80" w="160">keep as-is for now, this should be from 0.5-1.5 (or 0.5-2.0) at max.</comment><value name="VALUE"><shadow type="math_number"><field name="NUM">1</field></shadow></value><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="game.debug = true" numlines="1"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="game.stats = true" numlines="1"></mutation><next><block type="variables_set"><field name="VAR" id="+ns=oPAU|a;M/Pv|78a]">gameD_Upgrades</field><comment pinned="false" h="80" w="160">game data vars go here</comment><value name="VALUE"><shadow type="math_number"><field name="NUM">0</field></shadow><block type="lists_create_with"><mutation items="2" horizontalafter="3"></mutation><value name="ADD0"><shadow type="math_number"><field name="NUM">0</field></shadow></value><value name="ADD1"><shadow type="math_number"><field name="NUM">0</field></shadow></value></block></value><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="const savedData = settings.readJSON(&quot;BD8f_GameData&quot;)" numlines="1" declaredvars="savedData"></mutation><next><block type="device_while"><comment pinned="false" h="80" w="160">0 = menu, 1 = upgrades screen, 2-6 = levels 1-5</comment><value name="COND"><shadow type="logic_boolean"><field name="BOOL">TRUE</field></shadow></value><statement name="DO"><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="switch (current_screen) {" line1="        case 0:" line2="            cleanup()" line3="            let selection = 0 // bump this up by 2 when using this var to modify current_screen" line4="            let difficulty = 1 // 0 = ez 1 = normal, 2 = hard (optional code, ez = 0.5x spawn/hp?, normal = 1x, hard = 1.5x)" line5="            let dbg_isPressedA = false" line6="            let dbg_pressedData = [0, 0]" line7="            const lvlList = [&quot;Level 1&quot;, &quot;Level 2&quot;, &quot;Level 3&quot;, &quot;Level 4&quot;, &quot;Level 5&quot;]" line8="            const diff_lv = [&quot;Easy&quot;, &quot;Normal&quot;, &quot;Hard&quot;]" line9="            prt_id = &quot;0-1&quot;" line10="            if (prt_summoned.find(function (v, i) { return v === &quot;0-1&quot; }) === undefined) {" line11="                game.onPaint(function () {" line12="                    if (!(prt_id === &quot;0-1&quot;)) { return }" line13="" line14="                    screen.print(`Main Menu:\n(Dpad: move, A: select)\n\n\n\n\n\n\n\n\npress_data=[${dbg_pressedData[0]}, ${dbg_pressedData[1]}]\n@proj v0.1`, 0, 0)" line15="                    // build the menu string &amp; display here" line16="                    screen.print(&quot;\n\n\n\n\n\n\n\n\n&quot; + selection + &quot; - &quot; + difficulty, 0, 0) // debug" line17="                    let builtstr = &quot;&quot;" line18="                    lvlList.forEach(function (name, idx) { builtstr += `${selection === idx ? &quot;&gt;&quot; : &quot;&quot;} ${name} ${selection === idx ? (&quot; - &quot; + diff_lv[difficulty]) : &quot;&quot;}\n` })" line19="                    screen.print(&quot;\n\n\n&quot; + builtstr, 0, 0)" line20="                })" line21="                prt_summoned.push(&quot;0-1&quot;)" line22="            }" line23="            controller.up.onEvent(pressDown, function () { selection -= 1; selection &lt; 0 ? selection = 4 : false })" line24="            controller.down.onEvent(pressDown, function () { selection += 1; selection &gt; 4 ? selection = 0 : false })" line25="            controller.left.onEvent(pressDown, function () { difficulty -= 1; difficulty &lt; 0 ? difficulty = 2 : false })" line26="            controller.right.onEvent(pressDown, function () { difficulty += 1; difficulty &gt; 2 ? difficulty = 0 : false })" line27="            controller.A.onEvent(pressDown, function () { dbg_isPressedA = true; dbg_pressedData = [selection, difficulty] })" line28="            pauseUntil(() =&gt; dbg_isPressedA)" line29="            current_screen = selection + 2" line30="" line31="        case 1:" line32="            cleanup()" line33="            let sel: any = null // literally a 0 and a 1, true = sld, false = atk, null = unselected" line34="            let upg_sld = sprites.create(assets.image`upg_sld`, SpriteKind.Player)" line35="            let upg_atk = sprites.create(assets.image`upg_atk`, SpriteKind.Player)" line36="            // if (gameD_Upgrades[0] &gt; 2) {" line37="            //     var nimg = assets.image`upg_sld`" line38="" line39="            //     upg_sld.setImage()" line40="            // }" line41="            // scaling.scaleToPercent(upg_sld, 125, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line42="            // scaling.scaleToPercent(upg_atk, 125, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line43="            game.onUpdateInterval(50, function () {" line44="                if (sel === null) { return }" line45="                else if (sel === true) { // again: true = sld, false = atk, null = unselected" line46="                    scaling.scaleToPercent(upg_sld, 150, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line47="                    scaling.scaleToPercent(upg_atk, 100, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line48="                }" line49="                else {" line50="                    scaling.scaleToPercent(upg_sld, 100, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line51="                    scaling.scaleToPercent(upg_atk, 150, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line52="                }" line53="            })" line54="            prt_id = &quot;1-1&quot;" line55="            if (prt_summoned.find(function (v, i) { return v === &quot;1-1&quot; }) === undefined) {" line56="                game.onPaint(function () {" line57="                    if (!(prt_id === &quot;1-1&quot;)) { return }" line58="" line59="                    screen.print(&quot;\n    Choose an upgrade:\n     +DEF   or   +ATK&quot;, 2, 0)" line60="                    if (sel === null) { return }" line61="                    else if (sel === true) { // again: true = sld, false = atk, null = unselected" line62="                        let upgrade_str: string" line63="                        if (gameD_Upgrades[0] &gt;= 3) {" line64="                            upgrade_str = &quot;Max&quot;" line65="                        } else {" line66="                            upgrade_str = &quot;&quot; + gameD_Upgrades[0] + &quot;-&gt;&quot; + (gameD_Upgrades[0] + 1)" line67="                        }" line68="                        screen.print(&quot;\n\n\n\n+Defense &quot; + upgrade_str, 0, 12, 0, image.scaledFont(image.font8, 2))" line69="                        screen.print(&quot;\n\n\n\n\n\n\n\n\n\n   Increases your tank's\n   health&quot;, 0, 0)" line70="                    }" line71="                    else {" line72="                        let upgrade_str2: string" line73="                        if (gameD_Upgrades[1] &gt;= 3) {" line74="                            upgrade_str2 = &quot;Max&quot;" line75="                        } else {" line76="                            upgrade_str2 = &quot;&quot; + gameD_Upgrades[1] + &quot;-&gt;&quot; + (gameD_Upgrades[1] + 1)" line77="                        }" line78="                        screen.print(&quot;\n\n\n\n+Attack  &quot; + upgrade_str2, 0, 12, 0, image.scaledFont(image.font8, 2))" line79="                        screen.print(&quot;\n\n\n\n\n\n\n\n\n\n   Upgrades  your tank's\n   bullets&quot;, 0, 0)" line80="                    }" line81="                })" line82="                prt_summoned.push(&quot;1-1&quot;)" line83="            }" line84="            // function updateText()" line85="            controller.left.onEvent(pressDown, function () { sel = !sel })" line86="            controller.right.onEvent(pressDown, function () { sel = !sel })" line87="            upg_sld.x -= 35" line88="            upg_atk.x += 35" line89="" line90="            controller.A.onEvent(pressDown, function () {" line91="                if (sel === true &amp;&amp; gameD_Upgrades[0] &lt; 3) { // again: true = sld, false = atk, null = unselected" line92="                    gameD_Upgrades[0] += 1" line93="                }" line94="                else if (sel === false &amp;&amp; gameD_Upgrades[1] &lt; 3) {" line95="                    gameD_Upgrades[1] += 1" line96="                } // wtf?" line97="                console.log(gameD_Upgrades)" line98="                return" line99="            })" line100="            pauseUntil(() =&gt; current_screen === -516)" line101="" line102="" line103="" line104="        default:" line105="            cleanup()" line106="            game.onPaint(function () {" line107="                screen.print(&quot;\n\n\n\n   CRASH:\n   UNKNOWN SCREENID &quot; + current_screen, 0, 0)" line108="            })" line109="            pause(5000)" line110="            game.gameOver(" line111="                false" line112="            )" line113="            " line114="    }" numlines="115"></mutation></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" x="1670" y="20"><mutation name="cleanup" functionid="Kpu:-ODc0KGQ]Jpv+8+7"></mutation><field name="function_name">cleanup</field><statement name="STACK"><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.A.onEvent(pressDown, function () { })" numlines="1"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.B.onEvent(pressDown, function () { })" numlines="1"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.up.onEvent(pressDown, function () { })" numlines="1"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.down.onEvent(pressDown, function () { })" numlines="1"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.left.onEvent(pressDown, function () { })" numlines="1"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.right.onEvent(pressDown, function () { })" numlines="1"></mutation></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>