<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="AEMFec{y%]E)kc7a8qVP">current_diff</variable></variables><block type="function_definition" id="GSZMqJ7m]FB?gp?D}r#v" x="466" y="-52"><mutation name="cleanup" functionid="s6?RKKK$z#)^!4ly/WNh"></mutation><field name="function_name">cleanup</field><statement name="STACK"><block type="typescript_statement" id="a%bZK/;P]dJi[3|W5JlB"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.A.onEvent(pressDown, function () {})" numlines="1"></mutation><next><block type="typescript_statement" id="d*q8EQ+ovR}0)GlM,g+w"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.B.onEvent(pressDown, function () {})" numlines="1"></mutation><next><block type="typescript_statement" id="2NZ,6YAovpAe94FVBpw*"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.up.onEvent(pressDown, function () {})" numlines="1"></mutation><next><block type="typescript_statement" id="o0bv5B?G*MEz)twR[-rM"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.down.onEvent(pressDown, function () {})" numlines="1"></mutation><next><block type="typescript_statement" id="r#JqlMYB*`KKs}P|CN5~"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.left.onEvent(pressDown, function () {})" numlines="1"></mutation><next><block type="typescript_statement" id="Szo3]yASyL?zz,f!~y1J"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.right.onEvent(pressDown, function () {})" numlines="1"></mutation></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="pxt-on-start" id="(nEm+:R3wNg]Z[_18#3K" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="L;{H_$vZL=ot+|!XP*va"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="let current_screen = 0" numlines="1" declaredvars="current_screen"></mutation><next><block type="variables_set" id="mlMf(V]9hm7?#sE]n/y*"><field name="VAR" id="AEMFec{y%]E)kc7a8qVP">current_diff</field><comment pinned="false" h="80" w="160">keep as-is for now, this should be from 0.5-1.5 (or 0.5-2.0) at max.</comment><value name="VALUE"><shadow type="math_number" id="J/9(BGKBjL|Yi~ze?o`3"><field name="NUM">1</field></shadow></value><next><block type="typescript_statement" id="P96c)jc[9~OnjXHd/JH5"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="game.debug = true" numlines="1"></mutation><next><block type="typescript_statement" id="Yg/Y8dv$ehazB0wp!W+M"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="game.stats = true" numlines="1"></mutation><next><block type="typescript_statement" id="u{M0{?hRky0:K;mS(4KF"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="const pressDown = ControllerButtonEvent.Pressed" numlines="1" declaredvars="pressDown"></mutation><next><block type="device_while" id="OOSWr|xztmCyjk^`|kd*"><comment pinned="false" h="80" w="160">0 = menu, 1 = upgrades screen, 2-6 = levels 1-5</comment><value name="COND"><shadow type="logic_boolean" id="kMPY)jJJ`31sVAgI(moA"><field name="BOOL">TRUE</field></shadow></value><statement name="DO"><block type="typescript_statement" id="P@X;tsk)Nw+qxCx.hKID"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="switch (current_screen) {" line1="        case 0:" line2="            cleanup()" line3="            let selection = 0 // bump this up by 2 when using this var to modify current_screen" line4="            let difficulty = 1 // 0 = ez 1 = normal, 2 = hard (optional code, ez = 0.5x spawn/hp?, normal = 1x, hard = 1.5x)" line5="            let dbg_isPressedA = false" line6="            let dbg_pressedData = [0, 0]" line7="            const lvlList = [&quot;Level 1&quot;, &quot;Level 2&quot;, &quot;Level 3&quot;, &quot;Level 4&quot;, &quot;Level 5&quot;]" line8="            const diff_lv = [&quot;Easy&quot;, &quot;Normal&quot;, &quot;Hard&quot;]" line9="            game.onPaint(function () {" line10="                if (!(current_screen === 0)) {" line11="                    return" line12="                }" line13="                screen.print(`Main Menu:\n(Dpad: move, A: select)\n\n\n\n\n\n\n\n\npress_data=[${dbg_pressedData[0]}, ${dbg_pressedData[1]}]\n@proj v0.1`, 0, 0)" line14="                // build the menu string &amp; display here" line15="                screen.print(&quot;\n\n\n\n\n\n\n\n\n&quot; + selection + &quot; - &quot; + difficulty, 0, 0) // debug" line16="                let builtstr = &quot;&quot;" line17="                lvlList.forEach(function (name, idx) { builtstr += `${selection === idx ? &quot;&gt;&quot; : &quot;&quot;} ${name} ${selection === idx ? (&quot; - &quot; + diff_lv[difficulty]) : &quot;&quot;}\n`})" line18="                screen.print(&quot;\n\n\n&quot; + builtstr, 0, 0)" line19="            })" line20="            controller.up.onEvent(pressDown, function () { selection -= 1; selection &lt; 0 ? selection = 4 : false })" line21="            controller.down.onEvent(pressDown, function () { selection += 1; selection &gt; 4 ? selection = 0 : false })" line22="            controller.left.onEvent(pressDown, function () { difficulty -= 1; difficulty &lt; 0 ? difficulty = 2 : false })" line23="            controller.right.onEvent(pressDown, function () { difficulty += 1; difficulty &gt; 2 ? difficulty = 0 : false })" line24="            controller.A.onEvent(pressDown, function () { dbg_isPressedA = true; dbg_pressedData = [selection, difficulty] })" line25="            pauseUntil(() =&gt; dbg_isPressedA)" line26="            current_screen = selection + 2" line27="" line28="        case 1:" line29="" line30="" line31="        default:" line32="            cleanup()" line33="            game.onPaint(function() {" line34="                screen.print(&quot;\n\n\n\n   CRASH:\n   UNKNOWN SCREENID &quot; + current_screen + difficulty, 0, 0)" line35="            })" line36="            pauseUntil(() =&gt; current_screen === -517)" line37="    }" numlines="38"></mutation></block></statement></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>