" line0="let prt_summoned: Array&lt;string&gt; = []" numlines="1" declaredvars="prt_summoned"></mutation><next><block type="typescript_statement" id=")*:cxC`4o=qDhDn+[{Y`"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="const pressDown = ControllerButtonEvent.Pressed" numlines="1" declaredvars="pressDown"></mutation><next><block type="variables_set" id="W2OQ5LKHWrzBJtUHXXSD"><field name="VAR" id=":,s/I3A8kc:(FZSvJ[p@">current_screen</field><value name="VALUE"><shadow type="math_number" id="]DiHXzgG/n:PhLaNpF%;"><field name="NUM">1</field></shadow></value><next><block type="variables_set" id="5fP^V*6Ak:CcZ64CPN`j"><field name="VAR" id="-8|l`nhn83ETIszic^g:">prt_id</field><value name="VALUE"><shadow type="math_number" id="-DpVqR3CN~)7K:^+zli@"><field name="NUM">0</field></shadow><block type="text" id="x+o@Y~2E%]mI[ZPV;Zcm"><field name="TEXT">-1</field></block></value><next><block type="variables_set" id="q,qibb[f{4cs/tIh[WdR"><field name="VAR" id="$gEL){L3onRI:bW;16tL">current_diff</field><comment pinned="false" h="80" w="160">keep as-is for now, this should be from 0.5-1.5 (or 0.5-2.0) at max.</comment><value name="VALUE"><shadow type="math_number" id="[W%{cP=k%r7pGjckMtBW"><field name="NUM">1</field></shadow></value><next><block type="typescript_statement" id="lAX`I6!13ET*-DaPt%j)"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="game.debug = true" numlines="1"></mutation><next><block type="typescript_statement" id="KyZu^G5)Sf}@I(3G918x"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="game.stats = true" numlines="1"></mutation><next><block type="variables_set" id="%=cRD7,5re^h,d%Ba6CA"><field name="VAR" id="r7rw3IFU(BTJ2K+S@pJi">gameD_Upgrades</field><comment pinned="false" h="80" w="160">game data vars go here</comment><value name="VALUE"><shadow type="math_number" id="/d$fGiuwM]E7$a^74Rw-"><field name="NUM">0</field></shadow><block type="lists_create_with" id="2n|LF=Kp[SDrgEI/Aa(Z"><mutation items="2" horizontalafter="3"></mutation><value name="ADD0"><shadow type="math_number" id="%Cn~iKScOCFfz}R?/02*"><field name="NUM">0</field></shadow></value><value name="ADD1"><shadow type="math_number" id="MDmgy4fj(ky_Hj*4NAfI"><field name="NUM">0</field></shadow></value></block></value><next><block type="typescript_statement" id="I)^;%KF:rA@]!^q7@~?E"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="const savedData = settings.readJSON(&quot;BD8f_GameData&quot;)" numlines="1" declaredvars="savedData"></mutation><next><block type="device_while" id="+[o?M.-I,RGgewCAjG/9"><comment pinned="false" h="80" w="160">0 = menu, 1 = upgrades screen, 2-6 = levels 1-5</comment><value name="COND"><shadow type="logic_boolean" id="v6;4Puy`%-GxTjX;~r=a"><field name="BOOL">TRUE</field></shadow></value><statement name="DO"><block type="typescript_statement" id=")nD9.PlgZ|w10:o1@GU$"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="switch (current_screen) {" line1="        case 0:" line2="            cleanup()" line3="            let selection = 0 // bump this up by 2 when using this var to modify current_screen" line4="            let difficulty = 1 // 0 = ez 1 = normal, 2 = hard (optional code, ez = 0.5x spawn/hp?, normal = 1x, hard = 1.5x)" line5="            let dbg_isPressedA = false" line6="            let dbg_pressedData = [0, 0]" line7="            const lvlList = [&quot;Level 1&quot;, &quot;Level 2&quot;, &quot;Level 3&quot;, &quot;Level 4&quot;, &quot;Level 5&quot;]" line8="            const diff_lv = [&quot;Easy&quot;, &quot;Normal&quot;, &quot;Hard&quot;]" line9="            prt_id = &quot;0-1&quot;" line10="            if (prt_summoned.find(function (v, i) { return v === &quot;0-1&quot; }) === undefined) {" line11="                game.onPaint(function () {" line12="                    if (!(prt_id === &quot;0-1&quot;)) { return }" line13="" line14="                    screen.print(`Main Menu:\n(Dpad: move, A: select)\n\n\n\n\n\n\n\n\npress_data=[${dbg_pressedData[0]}, ${dbg_pressedData[1]}]\n@proj v0.1`, 0, 0)" line15="                    // build the menu string &amp; display here" line16="                    screen.print(&quot;\n\n\n\n\n\n\n\n\n&quot; + selection + &quot; - &quot; + difficulty, 0, 0) // debug" line17="                    let builtstr = &quot;&quot;" line18="                    lvlList.forEach(function (name, idx) { builtstr += `${selection === idx ? &quot;&gt;&quot; : &quot;&quot;} ${name} ${selection === idx ? (&quot; - &quot; + diff_lv[difficulty]) : &quot;&quot;}\n` })" line19="                    screen.print(&quot;\n\n\n&quot; + builtstr, 0, 0)" line20="                })" line21="                prt_summoned.push(&quot;0-1&quot;)" line22="            }" line23="            controller.up.onEvent(pressDown, function () { selection -= 1; selection &lt; 0 ? selection = 4 : false })" line24="            controller.down.onEvent(pressDown, function () { selection += 1; selection &gt; 4 ? selection = 0 : false })" line25="            controller.left.onEvent(pressDown, function () { difficulty -= 1; difficulty &lt; 0 ? difficulty = 2 : false })" line26="            controller.right.onEvent(pressDown, function () { difficulty += 1; difficulty &gt; 2 ? difficulty = 0 : false })" line27="            controller.A.onEvent(pressDown, function () { dbg_isPressedA = true; dbg_pressedData = [selection, difficulty] })" line28="            pauseUntil(() =&gt; dbg_isPressedA)" line29="            current_screen = selection + 2" line30="" line31="        case 1:" line32="            cleanup()" line33="            let sel: any = null // literally a 0 and a 1, true = sld, false = atk, null = unselected" line34="            let upg_sld = sprites.create(assets.image`upg_sld`, SpriteKind.Player)" line35="            let upg_atk = sprites.create(assets.image`upg_atk`, SpriteKind.Player)" line36="            // if (gameD_Upgrades[0] &gt; 2) {" line37="            //     var nimg = assets.image`upg_sld`" line38="" line39="            //     upg_sld.setImage()" line40="            // }" line41="            // scaling.scaleToPercent(upg_sld, 125, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line42="            // scaling.scaleToPercent(upg_atk, 125, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line43="            game.onUpdateInterval(50, function () {" line44="                if (sel === null) { return }" line45="                else if (sel === true) { // again: true = sld, false = atk, null = unselected" line46="                    scaling.scaleToPercent(upg_sld, 150, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line47="                    scaling.scaleToPercent(upg_atk, 100, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line48="                }" line49="                else {" line50="                    scaling.scaleToPercent(upg_sld, 100, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line51="                    scaling.scaleToPercent(upg_atk, 150, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line52="                }" line53="            })" line54="            prt_id = &quot;1-1&quot;" line55="            if (prt_summoned.find(function (v, i) { return v === &quot;1-1&quot; }) === undefined) {" line56="                game.onPaint(function () {" line57="                    if (!(prt_id === &quot;1-1&quot;)) { return }" line58="" line59="                    screen.print(&quot;\n    Choose an upgrade:\n     +DEF   or   +ATK&quot;, 2, 0)" line60="                    if (sel === null) { return }" line61="                    else if (sel === true) { // again: true = sld, false = atk, null = unselected" line62="                        screen.print(&quot;\n\n\n\n+Defense &quot; + gameD_Upgrades[0] + &quot;-&gt;&quot; + (gameD_Upgrades[0] + 1), 0, 12, 0, image.scaledFont(image.font8, 2))" line63="                        screen.print(&quot;\n\n\n\n\n\n\n\n\n\n   Increases your tank's\n   health&quot;, 0, 0)" line64="                    }" line65="                    else {" line66="                        screen.print(&quot;\n\n\n\n+Attack  &quot; + gameD_Upgrades[1] + &quot;-&gt;&quot; + (gameD_Upgrades[1] + 1), 0, 12, 0, image.scaledFont(image.font8, 2))" line67="                        screen.print(&quot;\n\n\n\n\n\n\n\n\n\n   Upgrades  your tank's\n   bullets&quot;, 0, 0)" line68="                    }" line69="                })" line70="                prt_summoned.push(&quot;1-1&quot;)" line71="            }" line72="            // function updateText()" line73="            controller.left.onEvent(pressDown, function () { sel = !sel })" line74="            controller.right.onEvent(pressDown, function () { sel = !sel })" line75="            upg_sld.x -= 35" line76="            upg_atk.x += 35" line77="" line78="            controller.A.onEvent(pressDown, function () {" line79="" line80="            })" line81="            pauseUntil(() =&gt; current_screen === -516)" line82="" line83="" line84="" line85="        default:" line86="            cleanup()" line87="            game.onPaint(function () {" line88="                screen.print(&quot;\n\n\n\n   CRASH:\n   UNKNOWN SCREENID &quot; + current_screen + difficulty, 0, 0)" line89="            })" line90="            pauseUntil(() =&gt; current_screen === -517)" line91="    }" numlines="92"></mutation></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>