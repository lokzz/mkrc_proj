<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="_q9C3T_$HV@CZG4?hWnG">current_screen</variable><variable id="W}Lr[(HQTr2._S+-=edz">prt_id</variable><variable id="pEo;iXN^wV8R?D2wR*5Q">current_diff</variable><variable id="g4T7Z^%,V1sk$LtK1h|F">gameD_Upgrades</variable><variable id="xkkO3KZ3nLJS-`b45?MY">gameD_scores</variable></variables><block type="function_definition" x="10" y="10"><mutation name="cleanup" functionid="ti!SU4J8|nm!~a(7mG0V"></mutation><field name="function_name">cleanup</field><statement name="STACK"><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.A.onEvent(pressDown, function () { })" numlines="1"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.B.onEvent(pressDown, function () { })" numlines="1"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.up.onEvent(pressDown, function () { })" numlines="1"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.down.onEvent(pressDown, function () { })" numlines="1"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.left.onEvent(pressDown, function () { })" numlines="1"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.right.onEvent(pressDown, function () { })" numlines="1"></mutation></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="pxt-on-start" x="10" y="10"><statement name="HANDLER"><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="let prt_summoned: Array&lt;string&gt; = []" numlines="1" declaredvars="prt_summoned"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="let sel: any = null" numlines="1" declaredvars="sel"></mutation><comment pinned="false" h="80" w="160">shit fix</comment><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="let prt_id = &quot;&quot;" numlines="1" declaredvars="prt_id"></mutation><next><block type="variables_set"><field name="VAR" id="_q9C3T_$HV@CZG4?hWnG">current_screen</field><value name="VALUE"><shadow type="math_number"><field name="NUM">2</field></shadow></value><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="const pressDown = ControllerButtonEvent.Pressed" numlines="1" declaredvars="pressDown"></mutation><next><block type="variables_set"><field name="VAR" id="W}Lr[(HQTr2._S+-=edz">prt_id</field><value name="VALUE"><shadow type="math_number"><field name="NUM">0</field></shadow><block type="text"><field name="TEXT">-1</field></block></value><next><block type="variables_set"><field name="VAR" id="pEo;iXN^wV8R?D2wR*5Q">current_diff</field><comment pinned="false" h="80" w="160">keep as-is for now, this should be from 0.5-1.5 (or 0.5-2.0) at max.</comment><value name="VALUE"><shadow type="math_number"><field name="NUM">1</field></shadow></value><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="game.stats = true" numlines="1"></mutation><next><block type="variables_set"><field name="VAR" id="g4T7Z^%,V1sk$LtK1h|F">gameD_Upgrades</field><comment pinned="false" h="80" w="160">game data vars go here</comment><value name="VALUE"><shadow type="math_number"><field name="NUM">0</field></shadow><block type="lists_create_with"><mutation items="2" horizontalafter="3"></mutation><value name="ADD0"><shadow type="math_number"><field name="NUM">1</field></shadow></value><value name="ADD1"><shadow type="math_number"><field name="NUM">1</field></shadow></value></block></value><next><block type="variables_set"><field name="VAR" id="xkkO3KZ3nLJS-`b45?MY">gameD_scores</field><comment pinned="false" h="80" w="160">scores[level(s)]: level[easy, normal, hard]</comment><value name="VALUE"><shadow type="math_number"><field name="NUM">0</field></shadow><block type="lists_create_with" inline="false"><mutation items="5" horizontalafter="3"></mutation><value name="ADD0"><block type="lists_create_with"><mutation items="3" horizontalafter="3"></mutation><value name="ADD0"><shadow type="math_number"><field name="NUM">-1</field></shadow></value><value name="ADD1"><shadow type="math_number"><field name="NUM">-1</field></shadow></value><value name="ADD2"><shadow type="math_number"><field name="NUM">-1</field></shadow></value></block></value><value name="ADD1"><block type="lists_create_with"><mutation items="3" horizontalafter="3"></mutation><value name="ADD0"><shadow type="math_number"><field name="NUM">-1</field></shadow></value><value name="ADD1"><shadow type="math_number"><field name="NUM">-1</field></shadow></value><value name="ADD2"><shadow type="math_number"><field name="NUM">-1</field></shadow></value></block></value><value name="ADD2"><block type="lists_create_with"><mutation items="3" horizontalafter="3"></mutation><value name="ADD0"><shadow type="math_number"><field name="NUM">-1</field></shadow></value><value name="ADD1"><shadow type="math_number"><field name="NUM">-1</field></shadow></value><value name="ADD2"><shadow type="math_number"><field name="NUM">-1</field></shadow></value></block></value><value name="ADD3"><block type="lists_create_with"><mutation items="3" horizontalafter="3"></mutation><value name="ADD0"><shadow type="math_number"><field name="NUM">-1</field></shadow></value><value name="ADD1"><shadow type="math_number"><field name="NUM">-1</field></shadow></value><value name="ADD2"><shadow type="math_number"><field name="NUM">-1</field></shadow></value></block></value><value name="ADD4"><block type="lists_create_with"><mutation items="3" horizontalafter="3"></mutation><value name="ADD0"><shadow type="math_number"><field name="NUM">-1</field></shadow></value><value name="ADD1"><shadow type="math_number"><field name="NUM">-1</field></shadow></value><value name="ADD2"><shadow type="math_number"><field name="NUM">-1</field></shadow></value></block></value></block></value><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="settings.writeJSON(&quot;BDDF_GameData&quot;, { upg: gameD_Upgrades, scr: gameD_scores })" numlines="1"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="const savedData = settings.readJSON(&quot;BDDF_GameData&quot;)" numlines="1" declaredvars="savedData"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="gameD_Upgrades = savedData.upg" numlines="1"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="gameD_scores = savedData.scr" numlines="1"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="const enemyDMG: { [key: number]: number } = { // level = dmg for now lol" line1="    1: 1," line2="    2: 2," line3="    3: 3" line4="}" numlines="5" declaredvars="enemyDMG"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="const enemyHP: { [key: number]: number } = { // subject to change" line1="    1: 1," line2="    2: 3," line3="    3: 5" line4="}" numlines="5" declaredvars="enemyHP"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="const playerDMG: { [key: number]: number } = {" line1="    1: 2," line2="    2: 4," line3="    3: 6" line4="}" numlines="5" declaredvars="playerDMG"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="const playerHP: { [key: number]: number } = { // what does &quot;scaling&quot; meaning" line1="    1: 1," line2="    2: 6," line3="    3: 10" line4="}" numlines="5" declaredvars="playerHP"></mutation><next><block type="device_while"><comment pinned="false" h="80" w="160">0 = menu, 1 = upgrades screen, 2-6 = levels 1-5</comment><value name="COND"><shadow type="logic_boolean"><field name="BOOL">TRUE</field></shadow></value><statement name="DO"><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="switch (current_screen) {" line1="        case 0:" line2="            cleanup()" line3="            let selection = 0 // bump this up by 2 when using this var to modify current_screen" line4="            let difficulty = 1 // 0 = ez 1 = normal, 2 = hard (optional code, ez = 0.5x spawn/hp?, normal = 1x, hard = 1.5x)" line5="            let dbg_isPressedA = false" line6="            let dbg_pressedData = [0, 0]" line7="            const lvlList = [&quot;Level 1&quot;, &quot;Level 2&quot;, &quot;Level 3&quot;, &quot;Level 4&quot;, &quot;Level 5&quot;]" line8="            const diff_lv = [&quot;Easy&quot;, &quot;Normal&quot;, &quot;Hard&quot;]" line9="            prt_id = &quot;0-1&quot;" line10="            if (prt_summoned.find(function (v, i) { return v === &quot;0-1&quot; }) === undefined) {" line11="                game.onPaint(function () {" line12="                    if (!(prt_id === &quot;0-1&quot;)) { return }" line13="" line14="                    screen.print(`Main Menu:\n(Dpad: move, A: select)\n\n\n\n\n\n\n\n\npress_data=[${dbg_pressedData[0]}, ${dbg_pressedData[1]}]\n@proj v0.1`, 0, 0)" line15="                    // build the menu string &amp; display here" line16="                    screen.print(&quot;\n\n\n\n\n\n\n\n\n&quot; + selection + &quot; - &quot; + difficulty, 0, 0) // debug" line17="                    let builtstr = &quot;&quot;" line18="                    lvlList.forEach(function (name, idx) { builtstr += `${selection === idx ? &quot;&gt;&quot; : &quot;&quot;} ${name} ${selection === idx ? (&quot; - &quot; + diff_lv[difficulty]) : &quot;&quot;}${(selection === idx &amp;&amp; gameD_scores[selection][difficulty] != -1) ? &quot; &gt; &quot; + gameD_scores[selection][difficulty] : &quot;&quot;}\n` })" line19="                    screen.print(&quot;\n\n\n&quot; + builtstr, 0, 0)" line20="                })" line21="                prt_summoned.push(&quot;0-1&quot;)" line22="            }" line23="            controller.up.onEvent(pressDown, function () { selection -= 1; selection &lt; 0 ? selection = 4 : false })" line24="            controller.down.onEvent(pressDown, function () { selection += 1; selection &gt; 4 ? selection = 0 : false })" line25="            controller.left.onEvent(pressDown, function () { difficulty -= 1; difficulty &lt; 0 ? difficulty = 2 : false })" line26="            controller.right.onEvent(pressDown, function () { difficulty += 1; difficulty &gt; 2 ? difficulty = 0 : false })" line27="            controller.A.onEvent(pressDown, function () { dbg_isPressedA = true; dbg_pressedData = [selection, difficulty] })" line28="            pauseUntil(() =&gt; dbg_isPressedA)" line29="            current_screen = selection + 2" line30="            break" line31="" line32="        case 1:" line33="            cleanup()" line34="            sel = null // literally a 0 and a 1, true = sld, false = atk, null = unselected" line35="            let upg_sld = sprites.create(assets.image`upg_sld`, SpriteKind.Player)" line36="            let upg_atk = sprites.create(assets.image`upg_atk`, SpriteKind.Player)" line37="            // if (gameD_Upgrades[0] &gt; 2) {" line38="            //     var nimg = assets.image`upg_sld`" line39="" line40="            //     upg_sld.setImage()" line41="            // }" line42="            // scaling.scaleToPercent(upg_sld, 125, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line43="            // scaling.scaleToPercent(upg_atk, 125, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line44="            game.onUpdateInterval(50, function () {" line45="                if (sel === null) { return }" line46="                else if (sel === true) { // again: true = sld, false = atk, null = unselected" line47="                    scaling.scaleToPercent(upg_sld, 150, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line48="                    scaling.scaleToPercent(upg_atk, 100, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line49="                }" line50="                else {" line51="                    scaling.scaleToPercent(upg_sld, 100, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line52="                    scaling.scaleToPercent(upg_atk, 150, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line53="                }" line54="            })" line55="            prt_id = &quot;1-1&quot;" line56="            if (prt_summoned.find(function (v, i) { return v === &quot;1-1&quot; }) === undefined) {" line57="                game.onPaint(function () {" line58="                    if (!(prt_id === &quot;1-1&quot;)) { return }" line59="" line60="                    screen.print(&quot;\n    Choose an upgrade:\n     +DEF   or   +ATK&quot;, 2, 0)" line61="                    console.log(sel)" line62="                    if (sel === null) { return }" line63="                    else if (sel === true) { // again: true = sld, false = atk, null = unselected" line64="                        let upgrade_str: string" line65="                        if (gameD_Upgrades[0] &gt;= 3) {" line66="                            upgrade_str = &quot;Max&quot;" line67="                        } else {" line68="                            upgrade_str = &quot;&quot; + gameD_Upgrades[0] + &quot;-&gt;&quot; + (gameD_Upgrades[0] + 1)" line69="                        }" line70="                        screen.print(&quot;\n\n\n\n+Defense &quot; + upgrade_str, 0, 12, 0, image.scaledFont(image.font8, 2))" line71="                        screen.print(&quot;\n\n\n\n\n\n\n\n\n\n   Increases your tank's\n   health&quot;, 0, 0)" line72="                    }" line73="                    else {" line74="                        let upgrade_str2: string" line75="                        if (gameD_Upgrades[1] &gt;= 3) {" line76="                            upgrade_str2 = &quot;Max&quot;" line77="                        } else {" line78="                            upgrade_str2 = &quot;&quot; + gameD_Upgrades[1] + &quot;-&gt;&quot; + (gameD_Upgrades[1] + 1)" line79="                        }" line80="                        screen.print(&quot;\n\n\n\n+Attack  &quot; + upgrade_str2, 0, 12, 0, image.scaledFont(image.font8, 2))" line81="                        screen.print(&quot;\n\n\n\n\n\n\n\n\n\n   Upgrades  your tank's\n   bullets&quot;, 0, 0)" line82="                    }" line83="                })" line84="                prt_summoned.push(&quot;1-1&quot;)" line85="            }" line86="            // function updateText()" line87="            controller.left.onEvent(pressDown, function () { sel = !sel; console.log(&quot;Left&quot;) })" line88="            controller.right.onEvent(pressDown, function () { sel = !sel; console.log(&quot;right&quot;) })" line89="            upg_sld.x -= 35" line90="            upg_atk.x += 35" line91="" line92="            let selected = -1" line93="            controller.A.onEvent(pressDown, function () {" line94="                if (sel === true &amp;&amp; gameD_Upgrades[0] &lt; 3) { // again: true = sld, false = atk, null = unselected" line95="                    selected = 0" line96="                    //gameD_Upgrades[0] += 1" line97="                }" line98="                else if (sel === false &amp;&amp; gameD_Upgrades[1] &lt; 3) {" line99="                    selected = 1" line100="                    //gameD_Upgrades[1] += 1" line101="                } // wtf?" line102="                return" line103="            })" line104="            pauseUntil(() =&gt; selected != -1) // should use sel instead but meh" line105="            sprites.destroy(upg_sld)" line106="            sprites.destroy(upg_atk)" line107="" line108="            gameD_Upgrades[selected] += 1 // no way it breaks right" line109="" line110="            current_screen = 0 // testing" line111="" line112="            break" line113="" line114="        case 2:" line115="            game.pushScene()" line116="" line117="            function give_pos() {" line118="                let range_x = [-2.5 * 16, 2.5 * 16]" line119="                let range_y = [4 * 16, 7 * 16]" line120="                let loc_x = randint(0 - range_x[0], 0 - range_x[1]) + scene.cameraProperty(CameraProperty.X)" line121="                let loc_y = Math.max((8 * 16), randint(0 - range_y[0], 0 - range_y[1]) + scene.cameraProperty(CameraProperty.Y))" line122="                return { &quot;x&quot;: loc_x, &quot;y&quot;: loc_y }" line123="            }" line124="            let v = 0" line125="            let tick = 0" line126="            let gameIsOver = false" line127="            let enemies: [Sprite, Sprite, number, number][] = [] // thing itself, walkTo, lastFireTick, level" line128="" line129="            const yourLooks: { [key: number]: Image } = { // okay maybe this should be outside here" line130="                1: assets.image`Level1`," line131="                2: assets.image`Level2`," line132="                3: assets.image`Level3`" line133="            }" line134="            const enemyLooks: { [key: number]: Image } = {" line135="                1: assets.image`E1`," line136="                2: assets.image`E2`," line137="                3: assets.image`E3`" line138="            }" line139="            const bullets: { [key: number]: Image } = {" line140="                1: assets.image`B1`," line141="                2: assets.image`B2`," line142="                3: assets.image`B3`" line143="            }" line144="" line145="            tiles.setCurrentTilemap(tilemap`level01_map`)" line146="            " line147="            let camera = sprites.create(assets.image`nil`, SpriteKind.Player)" line148="            let player = sprites.create(yourLooks[gameD_Upgrades[0]], SpriteKind.Player)" line149="            " line150="            controller.moveSprite(player, 40, 40)" line151="            player.setStayInScreen(true)" line152="            player.y = 58 * 16" line153="" line154="            scene.cameraFollowSprite(camera)" line155="            camera.y = 60 * 16" line156="            camera.vy = -15" line157="" line158="            let boss = sprites.create(assets.image`B1`)" line159="" line160="            const effectg = extraEffects.createFullPresetsSpreadEffectData(ExtraEffectPresetColor.Fire, ExtraEffectPresetShape.Spark)" line161="            sprites.onOverlap(SpriteKind.Enemy, SpriteKind.Projectile, function (oan, teo) {" line162="                let d = sprites.readDataNumber(teo, &quot;spawner&quot;)" line163="                if (d == -6) {" line164="                    let curHP = sprites.readDataNumber(oan, &quot;curHP&quot;)" line165="                    if (curHP - gameD_Upgrades[1] &lt;= 0) {" line166="                        sprites.setDataNumber(oan, &quot;curHP&quot;, -1515)" line167="                        extraEffects.createSpreadEffectAt(effectg, oan.x, oan.y, 100)" line168="                        oan.destroy()" line169="                    } else {" line170="                        let newHP = curHP - gameD_Upgrades[1]" line171="                        let statusbar" line172="                        statusbar = statusbars.getStatusBarAttachedTo(StatusBarKind.EnemyHealth, oan)" line173="                        if (statusbar === undefined) {" line174="                            statusbar = statusbars.create(20, 4, StatusBarKind.EnemyHealth)" line175="                            statusbar.attachToSprite(oan, 2)" line176="                            statusbar.setStatusBarFlag(StatusBarFlag.SmoothTransition, true)" line177="                            statusbar.max = sprites.readDataNumber(oan, &quot;maxHP&quot;)" line178="                        }" line179="                        statusbar.value = newHP" line180="                        sprites.setDataNumber(oan, &quot;curHP&quot;, newHP)" line181="                    }" line182="                    teo.destroy()" line183="                    return" line184="                }" line185="                console.log(enemies)" line186="                if ((enemies[d] as Sprite[])[0] == oan) {return}" line187="            })" line188="            sprites.onOverlap(SpriteKind.Player, SpriteKind.Projectile, function (oan, teo) {" line189="                let e = sprites.readDataNumber(teo, &quot;spawner&quot;)" line190="                if (e == -6) { return }" line191="                let dmg = enemyDMG[(enemies[e] as number[])[3]]" line192="                let statusbar2" line193="                statusbar2 = statusbars.getStatusBarAttachedTo(StatusBarKind.Health, oan)" line194="                if (statusbar2 === undefined) {" line195="                    statusbar2 = statusbars.create(20, 4, StatusBarKind.Health)" line196="                    statusbar2.attachToSprite(oan, 2)" line197="                    statusbar2.positionDirection(CollisionDirection.Bottom)" line198="                    statusbar2.setStatusBarFlag(StatusBarFlag.SmoothTransition, true)" line199="                    statusbar2.max = playerHP[gameD_Upgrades[0]]" line200="                }" line201="                statusbar2.value = statusbar2.value - dmg" line202="                if (statusbar2.value &lt;= 0) {" line203="                    game.onUpdate(function () {}) // stop it" line204="                    camera.vy = 0" line205="                    controller.moveSprite(player, 0, 0)" line206="                    scene.cameraFollowSprite(oan)" line207="                    pause(500)" line208="                    enemies.forEach(function (i, idx) {" line209="                        let theTarget = (i as Sprite[])[0]" line210="                        sprites.setDataNumber(theTarget, &quot;curHP&quot;, -1515)" line211="                    })" line212="                    let effecty = extraEffects.createFullPresetsSpreadEffectData(ExtraEffectPresetColor.Smoke, ExtraEffectPresetShape.Cloud)" line213="                    extraEffects.createSpreadEffectAt(effecty, oan.x, oan.y, 1250, 25)" line214="                    scene.cameraShake(2, 600)" line215="                    pause(500)" line216="                    enemies.forEach(function (i, idx) {" line217="                        let theTarget2 = (i as Sprite[])[0]" line218="                        extraEffects.createSpreadEffectAt(effectg, theTarget2.x, theTarget2.y, 100, 10, 10)" line219="                        theTarget2.destroy()" line220="                    })" line221="                    scene.cameraShake(4, 1100)" line222="                    pause(1000)" line223="                    scene.cameraShake(3, 750)" line224="                    extraEffects.createSpreadEffectAt(effectg, oan.x, oan.y, 1000, 100, 100)" line225="                    oan.destroy()" line226="                    pause(1000)" line227="                    current_screen = 0" line228="                    gameIsOver = true" line229="                }" line230="                teo.destroy()" line231="            })" line232="            const enemyLevels = [1] // change per level!!" line233="            game.onUpdate(function () {" line234="                // console.log(mySprite.tilemapLocation().x)" line235="                tick += 1" line236="                if (tick % 250 == 0 &amp;&amp; camera.y &gt; 120) { // spawn rate here!!!" line237="                    console.log(player.y)" line238="                    let nloc2 = give_pos()" line239="                    let newTarget = sprites.create(assets.image`nil`, SpriteKind.Food)" line240="                    newTarget.x = nloc2[&quot;x&quot;]" line241="                    newTarget.y = nloc2[&quot;y&quot;]" line242="                    let enemyLevel = enemyLevels[randint(0, enemyLevels.length-1)]" line243="                    let newEnemy = sprites.create(enemyLooks[enemyLevel], SpriteKind.Enemy)" line244="                    v = scene.cameraProperty(CameraProperty.X)" line245="                    newEnemy.x = randint(0, 1) == 1 ? v - (16 * 5) : v + (16 * 5)" line246="                    newEnemy.y = nloc2[&quot;y&quot;]" line247="                    newEnemy.setFlag(SpriteFlag.GhostThroughWalls, true)" line248="                    newEnemy.follow(newTarget, 18)" line249="                    sprites.setDataNumber(newEnemy, &quot;maxHP&quot;, enemyHP[enemyLevel])" line250="                    sprites.setDataNumber(newEnemy, &quot;curHP&quot;, enemyHP[enemyLevel])" line251="                    // controller.moveSprite(newEnemy, 40, 40)" line252="                    enemies.push([newEnemy, newTarget, tick, enemyLevel])" line253="                }" line254="                if (tick % 25 == 0) {" line255="                    enemies.forEach(function (i, idx) {" line256="                        let s = (i as Sprite[])" line257="                        if (sprites.readDataNumber(s[0], &quot;curHP&quot;) === -1515) { return }" line258="                        let t = (i as number[])[2]" line259="                        let l = (i as number[])[3]" line260="                        switch (l) {" line261="                            case 1: // only enemy level present here..." line262="                                if (tick - t &gt; 75) { // enemy fire rate!!! (1 tick = 0.033 seconds)" line263="                                    (enemies[idx] as number[])[2] = tick" line264="                                    let p = sprites.createProjectileFromSprite(bullets[l], s[0], 0, 50)" line265="                                    sprites.setDataNumber(p, &quot;spawner&quot;, idx)" line266="                                }" line267="                        }" line268="                    })" line269="                }" line270="                if (tick % 50 == 51) { // player fire rate" line271="                    let q = sprites.createProjectileFromSprite(bullets[gameD_Upgrades[1]], player, 0, -75)" line272="                    sprites.setDataNumber(q, &quot;spawner&quot;, -6)" line273="                }" line274="                enemies.forEach(function (i, idx) {" line275="                    let w = (i as Sprite[]) // dude why" line276="                    if (w[0] === null) { return }" line277="                    if (sprites.readDataNumber(w[0], &quot;curHP&quot;) === -1515) { return }" line278="                    if (w[1] &amp;&amp; w[0].x == w[1].x &amp;&amp; w[0].y == w[1].y) {" line279="                        w[1].destroy()" line280="                    }" line281="                })" line282="                if (player.isHittingTile(CollisionDirection.Top)) {" line283="                    camera.vy = 0" line284="                } else {" line285="                    camera.vy = -25" line286="                }" line287="            })" line288="" line289="            pauseUntil(() =&gt; gameIsOver == true)" line290="            // current_screen should be set in their separate death logic handlers" line291="            " line292="            game.popScene()" line293="            break" line294="" line295="        default:" line296="            cleanup()" line297="            screen.fill(15)" line298="            prt_id = &quot;NoneType&quot;" line299="            console.logValue(&quot;ScreenID&quot;, current_screen)" line300="            game.onPaint(function () {" line301="                screen.print(&quot;\n\n\n\n   CRASH:\n   UNKNOWN SCREENID &quot; + current_screen, 0, 0)" line302="            })" line303="            pause(5000)" line304="            game.gameOver(" line305="                false" line306="            )" line307="    }" numlines="308"></mutation></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>