onst savedData = settings.readJSON(&quot;BDDF_GameData&quot;)" numlines="1" declaredvars="savedData"></mutation><next><block type="device_while" id="ZGH.Ct`pTX{$*vOyhJ7M"><comment pinned="false" h="80" w="160">0 = menu, 1 = upgrades screen, 2-6 = levels 1-5</comment><value name="COND"><shadow type="logic_boolean" id="UkN28b$;ufnR;!ONVr]a"><field name="BOOL">TRUE</field></shadow></value><statement name="DO"><block type="typescript_statement" id="+_3#%zl$eb+6(xT||@rx"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="switch (current_screen) {" line1="        case 0:" line2="            cleanup()" line3="            let selection = 0 // bump this up by 2 when using this var to modify current_screen" line4="            let difficulty = 1 // 0 = ez 1 = normal, 2 = hard (optional code, ez = 0.5x spawn/hp?, normal = 1x, hard = 1.5x)" line5="            let dbg_isPressedA = false" line6="            let dbg_pressedData = [0, 0]" line7="            const lvlList = [&quot;Level 1&quot;, &quot;Level 2&quot;, &quot;Level 3&quot;, &quot;Level 4&quot;, &quot;Level 5&quot;]" line8="            const diff_lv = [&quot;Easy&quot;, &quot;Normal&quot;, &quot;Hard&quot;]" line9="            prt_id = &quot;0-1&quot;" line10="            if (prt_summoned.find(function (v, i) { return v === &quot;0-1&quot; }) === undefined) {" line11="                game.onPaint(function () {" line12="                    if (!(prt_id === &quot;0-1&quot;)) { return }" line13="" line14="                    screen.print(`Main Menu:\n(Dpad: move, A: select)\n\n\n\n\n\n\n\n\npress_data=[${dbg_pressedData[0]}, ${dbg_pressedData[1]}]\n@proj v0.1`, 0, 0)" line15="                    // build the menu string &amp; display here" line16="                    screen.print(&quot;\n\n\n\n\n\n\n\n\n&quot; + selection + &quot; - &quot; + difficulty, 0, 0) // debug" line17="                    let builtstr = &quot;&quot;" line18="                    lvlList.forEach(function (name, idx) { builtstr += `${selection === idx ? &quot;&gt;&quot; : &quot;&quot;} ${name} ${selection === idx ? (&quot; - &quot; + diff_lv[difficulty]) : &quot;&quot;}\n` })" line19="                    screen.print(&quot;\n\n\n&quot; + builtstr, 0, 0)" line20="                })" line21="                prt_summoned.push(&quot;0-1&quot;)" line22="            }" line23="            controller.up.onEvent(pressDown, function () { selection -= 1; selection &lt; 0 ? selection = 4 : false })" line24="            controller.down.onEvent(pressDown, function () { selection += 1; selection &gt; 4 ? selection = 0 : false })" line25="            controller.left.onEvent(pressDown, function () { difficulty -= 1; difficulty &lt; 0 ? difficulty = 2 : false })" line26="            controller.right.onEvent(pressDown, function () { difficulty += 1; difficulty &gt; 2 ? difficulty = 0 : false })" line27="            controller.A.onEvent(pressDown, function () { dbg_isPressedA = true; dbg_pressedData = [selection, difficulty] })" line28="            pauseUntil(() =&gt; dbg_isPressedA)" line29="            current_screen = selection + 2" line30="            break" line31="" line32="        case 1:" line33="            cleanup()" line34="            sel = null // literally a 0 and a 1, true = sld, false = atk, null = unselected" line35="            let upg_sld = sprites.create(assets.image`upg_sld`, SpriteKind.Player)" line36="            let upg_atk = sprites.create(assets.image`upg_atk`, SpriteKind.Player)" line37="            // if (gameD_Upgrades[0] &gt; 2) {" line38="            //     var nimg = assets.image`upg_sld`" line39="" line40="            //     upg_sld.setImage()" line41="            // }" line42="            // scaling.scaleToPercent(upg_sld, 125, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line43="            // scaling.scaleToPercent(upg_atk, 125, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line44="            game.onUpdateInterval(50, function () {" line45="                if (sel === null) { return }" line46="                else if (sel === true) { // again: true = sld, false = atk, null = unselected" line47="                    scaling.scaleToPercent(upg_sld, 150, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line48="                    scaling.scaleToPercent(upg_atk, 100, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line49="                }" line50="                else {" line51="                    scaling.scaleToPercent(upg_sld, 100, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line52="                    scaling.scaleToPercent(upg_atk, 150, ScaleDirection.Uniformly, ScaleAnchor.Middle)" line53="                }" line54="            })" line55="            prt_id = &quot;1-1&quot;" line56="            if (prt_summoned.find(function (v, i) { return v === &quot;1-1&quot; }) === undefined) {" line57="                game.onPaint(function () {" line58="                    if (!(prt_id === &quot;1-1&quot;)) { return }" line59="" line60="                    screen.print(&quot;\n    Choose an upgrade:\n     +DEF   or   +ATK&quot;, 2, 0)" line61="                    console.log(sel)" line62="                    if (sel === null) { return }" line63="                    else if (sel === true) { // again: true = sld, false = atk, null = unselected" line64="                        let upgrade_str: string" line65="                        if (gameD_Upgrades[0] &gt;= 3) {" line66="                            upgrade_str = &quot;Max&quot;" line67="                        } else {" line68="                            upgrade_str = &quot;&quot; + gameD_Upgrades[0] + &quot;-&gt;&quot; + (gameD_Upgrades[0] + 1)" line69="                        }" line70="                        screen.print(&quot;\n\n\n\n+Defense &quot; + upgrade_str, 0, 12, 0, image.scaledFont(image.font8, 2))" line71="                        screen.print(&quot;\n\n\n\n\n\n\n\n\n\n   Increases your tank's\n   health&quot;, 0, 0)" line72="                    }" line73="                    else {" line74="                        let upgrade_str2: string" line75="                        if (gameD_Upgrades[1] &gt;= 3) {" line76="                            upgrade_str2 = &quot;Max&quot;" line77="                        } else {" line78="                            upgrade_str2 = &quot;&quot; + gameD_Upgrades[1] + &quot;-&gt;&quot; + (gameD_Upgrades[1] + 1)" line79="                        }" line80="                        screen.print(&quot;\n\n\n\n+Attack  &quot; + upgrade_str2, 0, 12, 0, image.scaledFont(image.font8, 2))" line81="                        screen.print(&quot;\n\n\n\n\n\n\n\n\n\n   Upgrades  your tank's\n   bullets&quot;, 0, 0)" line82="                    }" line83="                })" line84="                prt_summoned.push(&quot;1-1&quot;)" line85="            }" line86="            // function updateText()" line87="            controller.left.onEvent(pressDown, function () { sel = !sel; console.log(&quot;Left&quot;)})" line88="            controller.right.onEvent(pressDown, function () { sel = !sel; console.log(&quot;right&quot;)})" line89="            upg_sld.x -= 35" line90="            upg_atk.x += 35" line91="" line92="            let selected = -1" line93="            controller.A.onEvent(pressDown, function () {" line94="                if (sel === true &amp;&amp; gameD_Upgrades[0] &lt; 3) { // again: true = sld, false = atk, null = unselected" line95="                    selected = 0" line96="                    //gameD_Upgrades[0] += 1" line97="                }" line98="                else if (sel === false &amp;&amp; gameD_Upgrades[1] &lt; 3) {" line99="                    selected = 1" line100="                    //gameD_Upgrades[1] += 1" line101="                } // wtf?" line102="                return" line103="            })" line104="            pauseUntil(() =&gt; selected != -1) // should use sel instead but meh" line105="            sprites.destroy(upg_sld)" line106="            sprites.destroy(upg_atk)" line107="" line108="            gameD_Upgrades[selected] += 1 // no way it breaks right" line109="            " line110="            current_screen = 2 // testing" line111="" line112="            break" line113="" line114="        case 2:" line115="            cleanup()" line116="            let dt = sprites.create(assets.image`nil`, SpriteKind.Player)" line117="            dt.sayText(&quot;hi&quot;)" line118="            pause(2000)" line119="            sprites.destroy(dt)" line120="            current_screen = 1" line121="            break" line122="" line123="        default:" line124="            cleanup()" line125="            screen.fill(15)" line126="            prt_id = &quot;NoneType&quot;" line127="            console.logValue(&quot;ScreenID&quot;, current_screen)" line128="            game.onPaint(function () {" line129="                screen.print(&quot;\n\n\n\n   CRASH:\n   UNKNOWN SCREENID &quot; + current_screen, 0, 0)" line130="            })" line131="            pause(5000)" line132="            game.gameOver(" line133="                false" line134="            )" line135="    }" numlines="136"></mutation></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="umLF16%Q7djr31)P~:$t" x="1650" y="0"><mutation name="cleanup" functionid="b8wzx,9^mOV*+Gqs94VK"></mutation><field name="function_name">cleanup</field><statement name="STACK"><block type="typescript_statement" id="qgRiY7?;4Cv`v~G$2S=w"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.A.onEvent(pressDown, function () {})" numlines="1"></mutation><next><block type="typescript_statement" id="#/YubCl@6?lHGVb3BJq3"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.B.onEvent(pressDown, function () {})" numlines="1"></mutation><next><block type="typescript_statement" id="qe8jc:)bY/${iN4:/$T4"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.up.onEvent(pressDown, function () {})" numlines="1"></mutation><next><block type="typescript_statement" id="Jn/Rk0/03BZR}?jMx~-w"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.down.onEvent(pressDown, function () {})" numlines="1"></mutation><next><block type="typescript_statement" id="yRet[v;N]1R0D2O1J]wR"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.left.onEvent(pressDown, function () {})" numlines="1"></mutation><next><block type="typescript_statement" id="R=Oz+S@3$Oqmc(]aK.0v"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.right.onEvent(pressDown, function () {})" numlines="1"></mutation></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>