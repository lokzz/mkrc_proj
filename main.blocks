           let loc_x2 = 0" line146="            let loc_y2 = 0" line147="            console.log(give_pos())" line148="            let mySprite = sprites.create(img`" line149="    3 3 " line150="    3 3 " line151="    `, SpriteKind.Player)" line152="            let mySprite2 = sprites.create(img`" line153="    4 4 4 4 " line154="    4 4 4 4 " line155="    4 4 4 4 " line156="    4 4 4 4 " line157="    `, SpriteKind.Player)" line158="            let enemy4 = sprites.create(img`" line159="    2 2 2 2 " line160="    2 2 2 2 " line161="    2 2 2 2 " line162="    2 2 2 2 " line163="    `, SpriteKind.Enemy)" line164="            let imagagag = [img`" line165="    . " line166="    `, img`" line167="    2 2 2 2 " line168="    2 2 2 2 " line169="    2 2 2 2 " line170="    2 2 2 2 " line171="    `]" line172="            game.stats = true" line173="            // game.consoleOverlay.setVisible(true)" line174="            enemy4.x = 0" line175="            enemy4.y = 0" line176="            enemy4.setFlag(SpriteFlag.GhostThroughWalls, true)" line177="            mySprite2.setStayInScreen(true)" line178="            scene.cameraFollowSprite(mySprite)" line179="            tiles.setCurrentTilemap(tilemap`level`)" line180="            // controller.moveSprite(mySprite, 200, 200)" line181="            mySprite.y = 60 * 16" line182="            mySprite.vy = -15" line183="            controller.moveSprite(mySprite, 40, 40)" line184="            sRange_x = [-2.5 * 16, 2.5 * 16]" line185="            game.onUpdate(function () {" line186="                // console.log(mySprite.tilemapLocation().x)" line187="                tick += 1" line188="                if (tick % 250 == 0 &amp;&amp; mySprite.y &gt; 120) {" line189="                    console.log(mySprite2.y)" line190="                    let nloc2 = give_pos()" line191="                    let newTarget = sprites.create(imagagag[0], SpriteKind.Food)" line192="                    newTarget.x = nloc2[&quot;x&quot;]" line193="                    newTarget.y = nloc2[&quot;y&quot;]" line194="                    let newEnemy = sprites.create(imagagag[1], SpriteKind.Enemy)" line195="                    v = scene.cameraProperty(CameraProperty.X)" line196="                    newEnemy.x = randint(0, 1) == 1 ? v - (16 * 5) : v + (16 * 5)" line197="                    newEnemy.y = nloc2[&quot;y&quot;]" line198="                    newEnemy.setFlag(SpriteFlag.GhostThroughWalls, true)" line199="                    newEnemy.follow(newTarget, 18)" line200="                    // controller.moveSprite(newEnemy, 40, 40)" line201="                    enemies.push([newEnemy, newTarget, tick, 0])" line202="                }" line203="                if (tick % 50 == 0) {" line204="                    enemies.forEach(function (i, idx) {" line205="                        let s = (i as Sprite[])" line206="                        let t = (i as number[])[2]" line207="                        if ((tick - t) &gt; 75) {" line208="                            sprites.createProjectileFromSprite(img`" line209="                    3 3 3 3 " line210="                    3 3 3 3 " line211="                    3 3 3 3 " line212="                    3 3 3 3 " line213="                `, s[0], 0, 50)" line214="                        }" line215="                    })" line216="                }" line217="                enemies.forEach(function (i, idx) {" line218="                    let w = (i as Sprite[]) // dude wtf" line219="                    if (w[1] &amp;&amp; w[0].x == w[1].x &amp;&amp; w[0].y == w[1].y) {" line220="                        w[1].destroy()" line221="                    }" line222="                    // if (enemy4.tilemapLocation().x / 16 &lt; 2 || enemy4.tilemapLocation().x / 16 &gt; 8) {" line223="                    //     enemy4.vx = enemy4.tilemapLocation().x &lt; 5 ? -16 : 16" line224="                    //     enemy4.vy = 5" line225="                    // } else if (spriteutils.distanceBetween(mySprite2, enemy4) &gt; 4 * 16) {" line226="                    //     enemy4.follow(mySprite2, 16)" line227="                    // } else {" line228="                    //     enemy4.follow(null)" line229="                    // }" line230="                })" line231="                if (mySprite2.isHittingTile(CollisionDirection.Top)) {" line232="                    mySprite.vy = 0" line233="                } else {" line234="                    mySprite.vy = -25" line235="                }" line236="            })" line237="" line238="            pauseUntil(() =&gt; current_screen == -517)" line239="" line240="        default:" line241="            cleanup()" line242="            screen.fill(15)" line243="            prt_id = &quot;NoneType&quot;" line244="            console.logValue(&quot;ScreenID&quot;, current_screen)" line245="            game.onPaint(function () {" line246="                screen.print(&quot;\n\n\n\n   CRASH:\n   UNKNOWN SCREENID &quot; + current_screen, 0, 0)" line247="            })" line248="            pause(5000)" line249="            game.gameOver(" line250="                false" line251="            )" line252="    }" numlines="253"></mutation></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>